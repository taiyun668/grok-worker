{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grok-ui.local/schemas/current-pointer.v5.schema.json",
  "title": "Grok Worker Provider v5 Deploy Pointer (current.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "releasePath", "dataRoot", "registryPath", "approvedProfileRoot", "schemaVersions"
  ],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "releasePath": { "type": "string", "minLength": 1 },
    "previousVersion": { "type": ["string", "null"] },
    "dataRoot": { "type": "string", "minLength": 1 },
    "registryPath": { "type": "string", "minLength": 1 },
    "approvedProfileRoot": { "type": "string", "minLength": 1 },
    "schemaVersions": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "manifestSha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
